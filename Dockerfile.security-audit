# Disposable build-time audit of the effective GrimeQuest Python runtime filesystem.
# Deliberately fails on HIGH/CRITICAL vulnerabilities with published fixes.
# The shipped runtime image uses this exact Python base + requirements.lock.
FROM aquasec/trivy:0.74.0 AS scanner

FROM python:3.13-slim@sha256:bf44cdfcb76cd3b41e879bc058fc37ec5872002ccfde7fcb765e218cde0cd79c AS runtime-audit
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir -r requirements.lock \
    && python -m pip check \
    && python -m pip list --format=freeze | grep -Ei '^(msgpack|setuptools|urllib3)==' || true
COPY server ./server
COPY run.py ./
COPY --from=scanner /usr/local/bin/trivy /usr/local/bin/trivy
RUN trivy --version \
    && trivy rootfs --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed \
       --exit-code 1 --no-progress / \
    && echo GQ_FINAL_RUNTIME_ROOTFS_TRIVY_PASS
CMD ["python","run.py","--host","0.0.0.0"]
