FROM python:3.13-slim@sha256:bf44cdfcb76cd3b41e879bc058fc37ec5872002ccfde7fcb765e218cde0cd79c AS python-runtime

FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

ENV DEBIAN_FRONTEND=noninteractive \
    GQ_CHROMIUM_EXECUTABLE=/usr/bin/chromium \
    PATH=/venv/bin:/usr/local/bin:$PATH

WORKDIR /src

# Use the exact Python 3.13 runtime family as production while keeping Node 22
# and system Chromium for the client/browser qualification suite.
COPY --from=python-runtime /usr/local /usr/local

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /venv

COPY requirements.lock requirements-dev.lock package.json package-lock.json tsconfig.json pyproject.toml ./

RUN python -m pip install --disable-pip-version-check --no-cache-dir -r requirements-dev.lock \
    && python -m pip check \
    && npm ci --ignore-scripts

COPY client ./client
COPY server ./server
COPY scripts ./scripts
COPY tests ./tests
COPY web ./web
COPY eval ./eval
COPY run.py ./

RUN python scripts/build.py \
    && npm run typecheck \
    && npm test \
    && python -m pytest --cov=server --cov-fail-under=90 \
    && python scripts/verify_build.py \
    && echo GQ_CLEAN_ROOM_QUALIFIED

CMD ["sh", "-c", "echo GQ_CLEAN_ROOM_IMAGE_READY; python -m http.server ${PORT:-8000} --bind 0.0.0.0"]
