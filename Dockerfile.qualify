FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS node-runtime

FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

ENV DEBIAN_FRONTEND=noninteractive \
    GQ_CHROMIUM_EXECUTABLE=/usr/bin/chromium \
    PATH=/venv/bin:/usr/local/bin:$PATH

WORKDIR /src

# Keep the exact Python 3.13 production base. Copy only Node/npm from the
# older-glibc pinned Node image into this newer-glibc runtime.
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version \
    && npm --version \
    && python --version \
    && apt-get update \
    && apt-get install -y --no-install-recommends chromium ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /venv

COPY requirements.lock requirements-dev.lock package.json package-lock.json tsconfig.json pyproject.toml ./

RUN python -m pip install --disable-pip-version-check --no-cache-dir -r requirements-dev.lock \
    && python -m pip check \
    && npm ci --ignore-scripts

COPY client ./client
COPY server ./server
COPY scripts ./scripts
COPY tests ./tests
COPY web ./web
# Reproduce the production Dockerfile's exact bundled ZXing browser scanner.
# Without this step, clean-room PWA tests incorrectly fail on a missing vendor asset.
RUN npm pack @zxing/library@0.21.3 --pack-destination /tmp --silent \
    && mkdir -p /tmp/zxing-package web/vendor \
    && tar -xzf /tmp/zxing-library-0.21.3.tgz -C /tmp/zxing-package package/umd/index.min.js package/LICENSE \
    && cp /tmp/zxing-package/package/umd/index.min.js web/vendor/zxing-0.21.3.min.js \
    && cp /tmp/zxing-package/package/LICENSE web/vendor/zxing.LICENSE.txt \
    && test -s web/vendor/zxing-0.21.3.min.js \
    && node --check web/vendor/zxing-0.21.3.min.js
COPY eval ./eval
# The release-archive documentation tests must inspect the exact public
# README and GitHub release guide; these are not copied to production runtime.
COPY README.md LICENSE SECURITY.md CONTRIBUTING.md CHANGELOG.md THIRD_PARTY_NOTICES.md ./
COPY .github/workflows/ci.yml ./.github/workflows/ci.yml
COPY docs/RELEASING.md ./docs/RELEASING.md
COPY run.py ./

RUN python scripts/build.py \
    && npm run typecheck \
    && npm test \
    && python -m pytest --cov=server --cov-fail-under=90 \
    && python scripts/verify_build.py \
    && echo GQ_CLEAN_ROOM_QUALIFIED

CMD ["sh", "-c", "echo GQ_CLEAN_ROOM_IMAGE_READY; python -m http.server ${PORT:-8000} --bind 0.0.0.0"]
