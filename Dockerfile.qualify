FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

ENV DEBIAN_FRONTEND=noninteractive \
    GQ_CHROMIUM_EXECUTABLE=/usr/bin/chromium \
    PATH=/venv/bin:$PATH

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv chromium ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /venv

COPY requirements.lock requirements-dev.lock package.json package-lock.json tsconfig.json pyproject.toml ./

RUN python -m pip install --disable-pip-version-check --no-cache-dir -r requirements-dev.lock \
    && python -m pip check \
    && npm ci --ignore-scripts

COPY client ./client
COPY server ./server
COPY scripts ./scripts
COPY tests ./tests
COPY web ./web
COPY eval ./eval
COPY run.py ./

RUN python scripts/build.py \
    && npm run typecheck \
    && npm test \
    && python -m pytest --cov=server --cov-fail-under=90 \
    && python scripts/verify_build.py \
    && echo GQ_CLEAN_ROOM_QUALIFIED

CMD ["sh", "-c", "echo GQ_CLEAN_ROOM_IMAGE_READY; sleep 600"]
