# Export these into your shell; run.py deliberately does NOT auto-load .env files.
# No model/key is enabled by default. No paid request is made in practice mode.
GQ_PROVIDER_BASE=
GQ_PROVIDER_MODEL=
GQ_PROVIDER_KEY=
# Required for live mode: random private access code, at least 24 characters.
GQ_ACCESS_CODE=
# Persistent HMAC secret for signed workflow receipts across restarts (32..256 characters).
GQ_TICKET_SECRET=
# External browser-facing origin when behind an HTTPS reverse proxy.
GQ_APP_ORIGIN=
# Global model-attempt limits per process (not monetary guarantees).
GQ_MAX_CALLS_HOUR=40
GQ_MAX_CALLS_DAY=200
# Local vision server only: allow HTTP to localhost / 127.0.0.1 / ::1.
GQ_ALLOW_LOCAL_PROVIDER=0
